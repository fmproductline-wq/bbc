# ── Ebook Info ─────────────────────────────────────────────────────────────
EBOOK_TITLE="My Amazing Ebook"
EBOOK_TAGLINE="The complete guide to achieving your goals"
EBOOK_PRICE="$9.99"
EBOOK_AUTHOR="Your Name"
EBOOK_DESCRIPTION="A comprehensive guide that teaches you..."
EBOOK_TOPICS="Topic 1,Topic 2,Topic 3"
EBOOK_COVER_IMAGE_URL="https://yoursite.com/cover.jpg"

# ── Sales Platforms ─────────────────────────────────────────────────────────
# Gumroad — get token from https://app.gumroad.com/settings/advanced
GUMROAD_ACCESS_TOKEN=
GUMROAD_PRODUCT_ID=

# Payhip — paste your product page URL directly
PAYHIP_PRODUCT_LINK=https://payhip.com/b/XXXXX

# SendOwl — https://www.sendowl.com/developers/api/introduction
SENDOWL_API_KEY=
SENDOWL_API_SECRET=
SENDOWL_PRODUCT_ID=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=https://yoursite.com/thank-you

# ── Social Media ────────────────────────────────────────────────────────────
# Twitter / X — https://developer.twitter.com/en/portal
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# LinkedIn — https://www.linkedin.com/developers/apps
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXXXX

# Meta (Facebook + Instagram) — https://developers.facebook.com/apps
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# Reddit — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDITS=ebooks,selfpublishing,entrepreneur

# Pinterest — https://developers.pinterest.com/apps/
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# Telegram (optional broadcast channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@yourchannel

# ── AI Content ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Scheduler ───────────────────────────────────────────────────────────────
POST_INTERVAL_HOURS=6
# Set to "all" or comma-separated: twitter,linkedin,facebook,instagram,reddit,pinterest,telegram
ACTIVE_PLATFORMS=all
