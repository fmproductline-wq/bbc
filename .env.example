# ── Wallet ──────────────────────────────────────────────────────────────
# Your Rabby wallet private key (keep this secret, never commit)
WALLET_PRIVATE_KEY=0xyour_private_key_here
WALLET_ADDRESS=0xyour_wallet_address_here

# EVM RPC endpoints (free tiers available at alchemy.com / infura.io)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Default chain to trade on: ethereum | polygon | bsc
DEFAULT_CHAIN=polygon

# ── 1inch DEX Aggregator ─────────────────────────────────────────────────
# Get free API key at https://portal.1inch.dev
ONEINCH_API_KEY=your_1inch_api_key_here

# ── TradingView Webhook ───────────────────────────────────────────────────
# Secret token to validate incoming TradingView alerts
TRADINGVIEW_WEBHOOK_SECRET=your_random_secret_token
# Optional: your saved TradingView chart layout ID (found in URL: /chart/<ID>/)
# Set this so clicking any asset auto-loads your saved indicators in TradingView
TV_LAYOUT_ID=

# ── Telegram Bot ─────────────────────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your Telegram user ID (get it from @userinfobot)
TELEGRAM_ALLOWED_USER_ID=123456789

# ── Prediction Markets ────────────────────────────────────────────────────
# Polymarket (uses your wallet private key above for signing)
POLYMARKET_API_KEY=your_polymarket_api_key
POLYMARKET_API_SECRET=your_polymarket_api_secret
POLYMARKET_API_PASSPHRASE=your_polymarket_passphrase

# Kalshi
KALSHI_EMAIL=your_kalshi_email@example.com
KALSHI_PASSWORD=your_kalshi_password
KALSHI_API_KEY=your_kalshi_api_key
# Use demo environment first: https://demo-api.kalshi.co
KALSHI_BASE_URL=https://trading-api.kalshi.com/trade-api/v2

# Metaculus (read-only questions + tracking)
METACULUS_TOKEN=your_metaculus_token

# ── Stripe Payments (sell the app from bestbrand.ca) ─────────────────────────
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
# Get this after setting up webhook at https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Create a one-time price in Stripe dashboard -> copy the price ID
STRIPE_PRICE_ID=price_your_price_id_here
# Your server's public URL (no trailing slash)
APP_BASE_URL=https://bestbrand.ca

# ── Platform Fee ──────────────────────────────────────────────────────────
# Creator wallet that receives 0.02% of every trade notional (Hyperliquid USD transfer)
FEE_WALLET_ADDRESS=0x35FC6d6d715Fe6B699783030BF3AdF2d75c6645a

# ── Risk Management ───────────────────────────────────────────────────────
# Max % of wallet to use per trade
MAX_TRADE_PCT=5
# Max % of wallet to bet on prediction markets per position
MAX_BET_PCT=2
# Slippage tolerance in percent for DEX swaps
SLIPPAGE_PCT=1
# Stop-loss percent below entry
STOP_LOSS_PCT=3
